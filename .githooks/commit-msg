#!/bin/sh

# Enforce Conventional Commit style in commit messages.
# Allowed types: feat, fix, chore, style, refactor, docs, test, ci, build, perf, revert.

commit_msg_file="$1"
commit_msg="$(cat "$commit_msg_file")"

pattern='^(feat|fix|chore|style|refactor|docs|test|ci|build|perf|revert)(\([^)[:space:]]+\))?: .+'

if printf "%s" "$commit_msg" | grep -Eq "$pattern"; then
  exit 0
fi

cat <<'EOF'
⛔ Commit message failed Conventional Commit check.
Expected: <type>(optional-scope): <description>
Allowed types: feat, fix, chore, style, refactor, docs, test, ci, build, perf, revert
Example: feat(player): add visualizer bar animations
EOF
exit 1
